{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingex.co.uk/schemas/public-data-package-manifest.schema.json",
  "title": "LingEx public data package manifest",
  "type": "object",
  "required": [
    "package_key",
    "title",
    "release_version",
    "source_keys",
    "material_type",
    "licence",
    "attribution",
    "changes",
    "included_files",
    "exclusions",
    "reviews"
  ],
  "properties": {
    "package_key": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "source_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "material_type": {
      "type": "string",
      "minLength": 1
    },
    "licence": {
      "type": "object",
      "required": [
        "key",
        "url"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "included_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviews": {
      "type": "object",
      "required": [
        "rights",
        "proprietary_exclusion",
        "privacy",
        "security",
        "technical"
      ]
    }
  }
}
